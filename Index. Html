<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ManagingPrestige - Social Media Management</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation Bar -->
    <nav>
        <div class="logo">ManagingPrestige</div>
        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- Hero Section -->
    <section id="home">
        <div class="hero-content">
            <h1>Grow Your Business with ManagingPrestige</h1>
            <p>We help businesses and influencers manage their social media presence.</p>
            <a href="#contact" class="btn">Get Started</a>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services">
        <h2>Our Services</h2>
        <div class="services-container">
            <div class="service">
                <h3>Social Media Management</h3>
                <p>We manage your accounts professionally.</p>
            </div>
            <div class="service">
                <h3>Content Creation</h3>
                <p>High-quality posts and videos.</p>
            </div>
            <div class="service">
                <h3>Follower Growth</h3>
                <p>Increase engagement and reach.</p>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about">
        <h2>About Us</h2>
        <p>We are experts in social media marketing and management.</p>
    </section>

    <!-- Contact Section -->
    <section id="contact">
        <h2>Contact Us</h2>
        <form id="contact-form">
            <input type="text" id="name" placeholder="Your Name" required>
            <input type="email" id="email" placeholder="Your Email" required>
            <textarea id="message" placeholder="Your Message" required></textarea>
            <button type="submit">Send Message</button>
        </form>
    </section>

    <script src="script.js"></script>

</body>
</html>
